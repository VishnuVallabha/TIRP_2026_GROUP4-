<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F7FA"
    android:padding="20dp">

    <TextView
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Back"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#4A6FA5"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SPEAK YOUR SYMPTOM"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#132238"
        android:gravity="center"
        android:layout_marginTop="40dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap microphone and describe your symptom"
        android:textSize="15sp"
        android:textColor="#6B88A8"
        android:gravity="center"
        android:layout_marginBottom="50dp"/>

    <TextView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:text="🎤"
        android:textSize="70sp"
        android:gravity="center"
        android:layout_gravity="center"/>

    <Button
        android:id="@+id/startSpeak"
        android:layout_width="220dp"
        android:layout_height="55dp"
        android:text="START SPEAKING →"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="16sp"
        android:backgroundTint="#1685D9"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"/>

</LinearLayout>