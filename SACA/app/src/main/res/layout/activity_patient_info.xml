<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Back -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#4A6FA5"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABOUT YOU"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="26sp"
            android:gravity="center"
            android:layout_marginTop="22dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This helps us give better health advice"
            android:textColor="#6C8DB5"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#FF6B35"
            android:layout_marginTop="16dp" />

        <!-- Age section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How old are you?"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scroll to select your age"
            android:textColor="#6C8DB5"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />

        <!-- Age display card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <NumberPicker
                android:id="@+id/agePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/ageDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="#FF6B35"
                    android:textStyle="bold"
                    android:textSize="56sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="years old"
                    android:textColor="#6C8DB5"
                    android:textSize="16sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Gender section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What is your gender?"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginTop="30dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/genderMale"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="♂ Male"
                android:textColor="#001F3F"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="@null"
                android:background="@drawable/body_part_card" />

            <Button
                android:id="@+id/genderFemale"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text="♀ Female"
                android:textColor="#001F3F"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="@null"
                android:background="@drawable/body_part_card" />

            <Button
                android:id="@+id/genderOther"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="⊕ Other"
                android:textColor="#001F3F"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="@null"
                android:background="@drawable/body_part_card" />

        </LinearLayout>

        <!-- Privacy note -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔒  Your information stays on this device and is never shared."
            android:textColor="#6C8DB5"
            android:textSize="12sp"
            android:layout_marginTop="20dp"
            android:gravity="center" />

        <!-- Next button -->
        <Button
            android:id="@+id/nextButton"
            android:layout_width="260dp"
            android:layout_height="58dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:text="CONTINUE →"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#FF6B35" />

    </LinearLayout>

</ScrollView>