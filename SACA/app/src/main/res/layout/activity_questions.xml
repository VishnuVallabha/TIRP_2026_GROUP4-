<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#4A6FA5"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- 🔊 Tap to Hear bar — matches desktop voice_bar widget -->
        <TextView
            android:id="@+id/tapToHear"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="🔊  Tap to Hear  /  Dhukarr ga wäŋa"
            android:textColor="#1685D9"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:background="#EEF1F8"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Progress timeline -->
        <TextView
            android:id="@+id/progressText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="① Body Part   ② Symptoms   ③ Questions   ④ Advice"
            android:textColor="#6C8DB5"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="#FF6B35"
            android:layout_marginTop="6dp" />

        <!-- Question counter -->
        <TextView
            android:id="@+id/questionNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Question 1 of 6"
            android:textSize="12sp"
            android:textColor="#5A77A5"
            android:gravity="center"
            android:layout_marginTop="14dp" />

        <!-- Question title -->
        <TextView
            android:id="@+id/questionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When did it start?"
            android:textStyle="bold"
            android:textSize="26sp"
            android:textColor="#132238"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <!-- Question subtitle -->
        <TextView
            android:id="@+id/questionSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap the best answer  ·  Nhaltjan warray ga djäma?"
            android:textColor="#6B7A90"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- Symptom chip -->
        <TextView
            android:id="@+id/symptomChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="Fever"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/symptom_chip_bg" />

        <!-- Answer cards grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginTop="18dp">

            <LinearLayout android:id="@+id/card1"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/option1"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 1" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

            <LinearLayout android:id="@+id/card2"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/option2"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 2" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

            <LinearLayout android:id="@+id/card3"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/option3"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 3" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

            <LinearLayout android:id="@+id/card4"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/option4"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 4" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

            <LinearLayout android:id="@+id/card5"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/option5"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 5" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

            <LinearLayout android:id="@+id/card6"
                android:layout_width="0dp" android:layout_height="110dp"
                android:layout_columnWeight="1" android:layout_margin="5dp"
                android:background="@drawable/question_card"
                android:gravity="center" android:orientation="vertical"
                android:visibility="gone">
                <TextView android:id="@+id/option6"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Option 6" android:textSize="13sp"
                    android:textStyle="bold" android:gravity="center"
                    android:textColor="#132238" />
            </LinearLayout>

        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDE3F0"
            android:layout_marginTop="14dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:text="NEXT  →"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:backgroundTint="#4ADE80"
            android:layout_gravity="center"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>

</ScrollView>
