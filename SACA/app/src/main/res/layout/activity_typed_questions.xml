<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#4A6FA5"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TYPE YOUR SYMPTOM"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/questionNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Question 2 of 6"
            android:textColor="#6C8DB5"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="25dp" />

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="When did it start?"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginTop="120dp" />

        <TextView
            android:id="@+id/questionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="e.g. today / yesterday / 2 days ago"
            android:textColor="#6C8DB5"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/answerInput"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="28dp"
            android:hint="Type answer"
            android:padding="14dp"
            android:textSize="16sp"
            android:background="#FFFFFF"
            android:singleLine="true" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/nextButton"
            android:layout_width="220dp"
            android:layout_height="55dp"
            android:layout_gravity="end"
            android:layout_marginTop="140dp"
            android:text="NEXT →"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#247BBC" />

    </LinearLayout>

</ScrollView>