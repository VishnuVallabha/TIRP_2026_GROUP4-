<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back -->
        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="#5B7BAA"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Progress: step 4 active -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✔ Body Part   ✔ Symptoms   ✔ Questions   ④ Advice"
            android:textColor="#009B72"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Page title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Result"
            android:textColor="#001F3F"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="14dp" />

        <!-- Symptom + timestamp row -->
        <TextView
            android:id="@+id/symptomTimestamp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fever  ·  —"
            android:textColor="#6C8DB5"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- Result banner — English title -->
        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="😟  MODERATE — SEE A DOCTOR"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="18sp"
            android:background="#FF6B35" />

        <!-- Yolngu result subtitle — "Märr Djuy'yun" etc -->
        <TextView
            android:id="@+id/resultYolngu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Märr Djuy'yun"
            android:textColor="#FF6B35"
            android:textStyle="italic"
            android:textSize="16sp"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <!-- Main message card -->
        <TextView
            android:id="@+id/resultMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Visit the Yirrkala clinic within 24 hours."
            android:textColor="#FF6B35"
            android:textStyle="bold"
            android:textSize="16sp"
            android:padding="16dp"
            android:background="#FFF8E8"
            android:layout_marginTop="8dp" />

        <!-- What To Do Now label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What To Do Now"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp" />

        <!-- Action cards — built dynamically in Java -->
        <LinearLayout
            android:id="@+id/actionCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Contact strip -->
        <TextView
            android:id="@+id/contactStrip"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="☎  Yirrkala Clinic: (08) 8987 1000  ·  Mon–Fri 8am–5pm"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="12sp"
            android:background="#FF6B35" />

        <!-- Your Answers summary -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Answers"
            android:textColor="#001F3F"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/summaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp" />

        <!-- Buttons -->
        <Button
            android:id="@+id/saveReportButton"
            android:layout_width="260dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:text="💾  SAVE REPORT"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF6B35" />

        <Button
            android:id="@+id/startOverButton"
            android:layout_width="260dp"
            android:layout_height="55dp"
            android:layout_gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="20dp"
            android:text="↩  START OVER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6C8DB5" />

    </LinearLayout>

</ScrollView>
